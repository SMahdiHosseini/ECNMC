[DCSim]
switchREDQueueDiscMaxSize=300KB
incastMessageSize=30000
incastFactor=6
incastperiod=200us
# Periodic ML-style incast. periodicSenders hosts of rack 0 each post one periodicMsgSize-byte
# message to R<periodicDstRack>H<periodicDstHost> at deterministic instants 1/hostTrafficRate
# apart, over the pre-established connection pool. The traffic size CDF is not used.
# `load` plays no part: the incast is specified directly by periodicPeriod and periodicMsgSize.
#   senders           periodicSenderRacks * periodicSenders   (2 racks x 6 hosts = 12 here)
#   burst per period  senders * periodicMsgSize
#   busy fraction     delta = 8 * burst / (periodicPeriod * hostToTorLinkRate)
#   expected bias     1 / delta, the factor by which an all-packets mean delay overstates the
#                     time-average that the switch-side Poisson sampler measures
#
# BURSTINESS SWEEP: hold the burst volume fixed and sweep periodicPeriod. The same bytes get
# concentrated into rarer bursts, so delta falls and the naive all-packets estimator degrades as
# 1/delta, while a Poissonized sample should stay flat. At 12 senders x 4096 B = 49 KB per burst:
#   period    12.5us   25us    50us    100us   200us
#   delta     0.315    0.157   0.079   0.039   0.020
#   bias      3.2x     6.4x    12.7x   25.4x   50.9x
#   periods   240000   120000  60000   30000   15000     (in a 3 s window)
#   3% of it  7200     3600    1800    900     450       <- largest findable Poisson subsample
# The last row is the limit: thinning a perfectly periodic stream leaves gaps that are integer
# multiples of the period, and Anderson-Darling rejects that lattice above ~3% retention, so the
# biggest subsample is ~3% of the periods in the window. It has to clear the consistency check's
# minimum sample size (~600), which is why the long-period end of the sweep runs out of samples --
# that boundary is itself a result worth plotting.
#
# 49 KB per burst is 82% of the 60 KB ECN marking threshold (MinTh=0.6 of the 100 KB BDP-sized
# last-hop buffer). Staying under it is what lets pacing stay enabled -- see the pctPacedBack note.
# Raising periodicSenders/periodicMsgSize/periodicSenderRacks past that threshold re-smears it.
#
# periodicDstHosts hands each sending rack its own receiver in rack 2, cycling from periodicDstHost:
#   1 -> every sending rack converges on R2H3            (one incast, strongest signal, the default)
#   2 -> rack 0 -> R2H3, rack 1 -> R2H4                  (two concurrent incasts sharing the fabric)
# Rack 2 never sends (intra-rack traffic would bypass T0A0/A0T2). Spreading halves the burst each
# last hop sees, so halve the ECN headroom calculation with it -- or raise periodicSenderRacks to
# 3 (racks 0,1,3) to keep 2 racks per receiver.
periodicTraffic=0
periodicSenderRacks=3
periodicSenders=6
periodicMsgSize=2048
periodicPeriod=12.800us
periodicDstRack=2
periodicDstHost=3
periodicDstHosts=3
# 0 = every sender fires at the same instant (one batch, maximum burstiness);
# 1 = phases spread evenly over the period (near-deterministic smooth stream). The burstiness knob.
periodicPhaseSpread=0.0
# Per-message dither in ns, applied around the exact periodic grid (never accumulating).
# Without it, senders firing at the identical nanosecond are served in ns-3's fixed tie-break
# order, which pinned R0H0 at the head of every batch: it measured 0 ns while R0H1..R0H5 measured
# 246/427/590/719/843 ns. 5 ns is 4% of one packet's 120 ns serialisation, so the burst still
# coincides -- but see the note in sweep_burstiness.py: at ns-3's 1 ns time resolution only 5
# distinct values exist, so 6 senders tie 67% of the time and R0H0 still wins those. 50 ns (42% of
# a packet time, still fully coincident) drops the tie rate to 10%.
periodicJitterNs=50
